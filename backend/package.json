{
  "name": "reachinbox-backend",
  "version": "1.0.0",
  "description": "Full-stack Email Scheduler Backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "worker": "node dist/workers/standaloneWorker.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/workers/standaloneWorker.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:worker\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "test": "jest --detectOpenHandles"
  },
  "dependencies": {
    "@bull-board/api": "^5.14.0",
    "@bull-board/express": "^5.14.0",
    "@elastic/elasticsearch": "^8.12.0",
    "@prisma/client": "^5.10.0",
    "@slack/web-api": "^7.0.0",
    "axios": "^1.6.7",
    "bullmq": "^5.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "google-auth-library": "^9.6.3",
    "googleapis": "^133.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.10"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.24",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^6.0.2",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "prisma": "^5.10.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
